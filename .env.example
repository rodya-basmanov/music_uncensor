# Telegram
BOT_TOKEN=your_bot_token_here

# Proxy (опционально, если нужен обход блокировки Telegram)
# ВНИМАНИЕ: нужен SOCKS5/HTTP, а не MTProto. Пример: socks5://127.0.0.1:10808
TELEGRAM_PROXY_URL=
# on — требовать прокси (не фолбэкать на прямое соединение при недоступном прокси)
TELEGRAM_PROXY_REQUIRED=off

# VK (user access token — нужен для плейлистов по ссылке)
# Как получить: см. README (раздел «VK-токен»)
VK_TOKEN=

# Режим обработки VK-плейлиста: ask | uncensored | vk
VK_PLAYLIST_MODE=ask

# Порядок источников поиска (через запятую): youtube, soundcloud
SOURCE_ORDER=youtube,soundcloud

# Прокси для yt-dlp (YouTube блокируется в РФ). По умолчанию = TELEGRAM_PROXY_URL
YTDLP_PROXY=

# Провайдер PO-токенов для YouTube (bgutil-ytdlp-pot-provider).
# Локально: docker run -d -p 4416:4416 --name bgutil brainicism/bgutil-ytdlp-pot-provider
# Тогда: YTDLP_POT_PROVIDER=http://127.0.0.1:4416
YTDLP_POT_PROVIDER=

# Paths
DATA_DIR=./data

# Playlist
MAX_PLAYLIST_SIZE=500
# Сколько треков обрабатывать параллельно (1 — последовательно)
CONCURRENCY=3
# Минимальная пауза между отправками аудио в канал (сек) — защита от FloodWait
SEND_INTERVAL=3

# Задержка между треками при поиске (анти-бан, сек)
RATE_LIMIT_SEARCH_SEC=2

# Cache
CACHE_DIR=./data/cache
CACHE_TTL_DAYS=7
MAX_CACHE_SIZE_GB=20

# Logging
LOG_LEVEL=INFO

# Подпись под аудио: «🎧 song.link (<url>) · via @<bot>» (on/off)
AUDIO_CAPTION=on
# Переопределить username в «via» (по умолчанию — username самого бота)
VIA_USERNAME=

# Минимальный fuzzy-скор (0-100) для подстановки VK-обложки; иначе — обложка источника
VK_COVER_MIN_SCORE=90

# Sentry (опционально, для мониторинга ошибок)
SENTRY_DSN=

# Webhook (альтернатива polling)
# WEBHOOK_MODE=false
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=your_secret_token

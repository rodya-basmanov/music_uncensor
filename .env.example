# Telegram
BOT_TOKEN=your_bot_token_here

# Proxy (опционально, если нужен обход блокировки Telegram)
TELEGRAM_PROXY_URL=

# Fuzzy matching
FUZZY_THRESHOLD=85
MAX_PLAYLIST_SIZE=100

# Cache
CACHE_DIR=./data/cache
CACHE_TTL_DAYS=7
MAX_CACHE_SIZE_GB=20

# Rate limits (seconds)
RATE_LIMIT_SEARCH_SEC=2
RATE_LIMIT_DOWNLOAD_SEC=2

# Logging
LOG_LEVEL=INFO

# Sentry (опционально, для мониторинга ошибок)
SENTRY_DSN=

# Webhook (альтернатива polling)
# WEBHOOK_MODE=false
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PATH=/webhook
# WEBHOOK_SECRET=your_secret_token
